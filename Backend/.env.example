# ==============================================================================
# EventForge Backend Production & Deployment Configuration
# ==============================================================================

# Runtime Environment (production, development, test)
NODE_ENV=production

# Server HTTP Port
PORT=5000

# MongoDB Connection URI (e.g., MongoDB Atlas, Cosmos DB, or self-hosted)
MONGODB_URI=mongodb://localhost:27017/eventforge

# Security: Generate high-entropy 64-char keys in production using `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_access_secret_in_production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_secure_random_64_character_refresh_secret_in_production
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=replace_with_a_secure_random_cookie_signing_key_in_production

# CORS: Allowed frontend origins (comma-separated for multi-domain support)
# Example: https://app.eventforge.com,https://eventforge.com
CORS_ORIGIN=http://localhost:3000

# File Upload Directory (relative or absolute path)
UPLOAD_DIR=uploads

# Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500

# Optional: Initial Platform SuperAdmin Provisioning (used by `npm run create-admin`)
INITIAL_ADMIN_NAME=Platform Administrator
INITIAL_ADMIN_EMAIL=admin@yourdomain.com
INITIAL_ADMIN_PASSWORD=SetSecurePasswordHere123!

# AI Assistant Integration (optional: template, openai, anthropic)
AI_PROVIDER=template
AI_API_KEY=
